__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Variáveis de ambiente / segredos locais
.env
.env.*

# Testes e ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

